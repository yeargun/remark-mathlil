import { arrLen, call0, call1, call2, jsString, objGet, push, replaceStr, undef } from "./host.lil";

JsValue classNames(string first, string second) {
  JsValue names = JS.array();
  push(names, first);
  push(names, second);
  return names;
}

JsValue textNode(string value) {
  JsValue node = JS.object();
  JS.set(node, "type", "text");
  JS.set(node, "value", value);
  return node;
}

JsValue enterMathFlow = JS.method1((JsValue self, JsValue token) => {
  JsValue props = JS.object();
  JS.set(props, "className", classNames("language-math", "math-display"));
  JsValue children = JS.array();
  JsValue code = JS.object();
  JS.set(code, "type", "element");
  JS.set(code, "tagName", "code");
  JS.set(code, "properties", props);
  JS.set(code, "children", children);
  JsValue hChildren = JS.array();
  push(hChildren, code);
  JsValue data = JS.object();
  JS.set(data, "hName", "pre");
  JS.set(data, "hChildren", hChildren);
  JsValue node = JS.object();
  JS.set(node, "type", "math");
  JS.set(node, "meta", null);
  JS.set(node, "value", "");
  JS.set(node, "data", data);
  call2(objGet(self, "enter"), self, node, token);
  return undef();
});

JsValue enterMathFlowMeta = JS.method1((JsValue self, JsValue _token) => {
  call0(objGet(self, "buffer"), self);
  return undef();
});

JsValue exitMathFlowMeta = JS.method1((JsValue self, JsValue _token) => {
  JsValue data = call0(objGet(self, "resume"), self);
  JsValue stack = objGet(self, "stack");
  JS.set(stack[arrLen(stack) - 1], "meta", data);
  return undef();
});

JsValue exitMathFlowFence = JS.method1((JsValue self, JsValue _token) => {
  if (objGet(objGet(self, "data"), "mathFlowInside").truthy()) {
    return undef();
  }
  call0(objGet(self, "buffer"), self);
  JS.set(objGet(self, "data"), "mathFlowInside", true);
  return undef();
});

JsValue exitMathFlow = JS.method1((JsValue self, JsValue token) => {
  Regex strip = new Regex("^(\\r?\\n|\\r)|(\\r?\\n|\\r)$", "g");
  string data = replaceStr(call0(objGet(self, "resume"), self), strip, "");
  JsValue stack = objGet(self, "stack");
  JsValue node = stack[arrLen(stack) - 1];
  call1(objGet(self, "exit"), self, token);
  JS.set(node, "value", data);
  JsValue kids = objGet(objGet(objGet(node, "data"), "hChildren")[0], "children");
  push(kids, textNode(data));
  JS.set(objGet(self, "data"), "mathFlowInside", undef());
  return undef();
});

JsValue enterMathText = JS.method1((JsValue self, JsValue token) => {
  JsValue hProps = JS.object();
  JS.set(hProps, "className", classNames("language-math", "math-inline"));
  JsValue hChildren = JS.array();
  JsValue data = JS.object();
  JS.set(data, "hName", "code");
  JS.set(data, "hProperties", hProps);
  JS.set(data, "hChildren", hChildren);
  JsValue node = JS.object();
  JS.set(node, "type", "inlineMath");
  JS.set(node, "value", "");
  JS.set(node, "data", data);
  call2(objGet(self, "enter"), self, node, token);
  call0(objGet(self, "buffer"), self);
  return undef();
});

JsValue exitMathText = JS.method1((JsValue self, JsValue token) => {
  string data = jsString(call0(objGet(self, "resume"), self));
  JsValue stack = objGet(self, "stack");
  JsValue node = stack[arrLen(stack) - 1];
  call1(objGet(self, "exit"), self, token);
  JS.set(node, "value", data);
  push(objGet(objGet(node, "data"), "hChildren"), textNode(data));
  return undef();
});

JsValue exitMathData = JS.method1((JsValue self, JsValue token) => {
  JsValue enterData = objGet(objGet(objGet(self, "config"), "enter"), "data");
  JsValue exitData = objGet(objGet(objGet(self, "config"), "exit"), "data");
  JS.call(enterData, self, token);
  JS.call(exitData, self, token);
  return undef();
});

export JsValue mathFromMarkdown() {
  JsValue enter = JS.object();
  JS.set(enter, "mathFlow", enterMathFlow);
  JS.set(enter, "mathFlowFenceMeta", enterMathFlowMeta);
  JS.set(enter, "mathText", enterMathText);
  JsValue exit = JS.object();
  JS.set(exit, "mathFlow", exitMathFlow);
  JS.set(exit, "mathFlowFence", exitMathFlowFence);
  JS.set(exit, "mathFlowFenceMeta", exitMathFlowMeta);
  JS.set(exit, "mathFlowValue", exitMathData);
  JS.set(exit, "mathText", exitMathText);
  JS.set(exit, "mathTextData", exitMathData);
  JsValue extension = JS.object();
  JS.set(extension, "enter", enter);
  JS.set(extension, "exit", exit);
  return extension;
}
