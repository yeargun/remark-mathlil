import { call0, call1, call2, objGet, push, undef } from "./host.lil";

JsValue classNames(string first, string second) {
  return JS.array(first, second);
}

JsValue textNode(string value) {
  return JS.object("type", "text", "value", value);
}

export JsValue mathFromMarkdown() {
JsValue enterMathFlow = JS.method1((JsValue self, JsValue token) => {
  JsValue code = JS.object(
    "type", "element",
    "tagName", "code",
    "properties", JS.object("className", classNames("language-math", "math-display")),
    "children", JS.array()
  );
  JsValue node = JS.object(
    "type", "math",
    "meta", null,
    "value", "",
    "data", JS.object("hName", "pre", "hChildren", JS.array(code))
  );
  JS.invoke(self, "enter", node, token);
  return undef();
});

JsValue enterMathFlowMeta = JS.method0((JsValue self) => {
  JS.invoke(self, "buffer");
  return undef();
});

JsValue exitMathFlowMeta = JS.method0((JsValue self) => {
  JsValue data = JS.invoke(self, "resume");
  JsValue[] stack = JS.assume(self["stack"]);
  stack[stack.length - 1]["meta"] = data;
  return undef();
});

JsValue exitMathFlowFence = JS.method0((JsValue self) => {
  if (!self["data"]["mathFlowInside"].truthy()) {
    JS.invoke(self, "buffer");
    self["data"]["mathFlowInside"] = true;
  }
  return undef();
});

JsValue exitMathFlow = JS.method1((JsValue self, JsValue token) => {
  Regex strip = new Regex("^(\\r?\\n|\\r)|(\\r?\\n|\\r)$", "g");
  string resumed = JS.assume(JS.invoke(self, "resume"));
  string data = resumed.replace(strip, "");
  JsValue[] stack = JS.assume(self["stack"]);
  JsValue node = stack[stack.length - 1];
  JS.invoke(self, "exit", token);
  node["value"] = data;
  JS.invoke(node["data"]["hChildren"][0]["children"], "push", textNode(data));
  (self["data"])["mathFlowInside"] = undef();
  return undef();
});

JsValue enterMathText = JS.method1((JsValue self, JsValue token) => {
  JsValue node = JS.object(
    "type", "inlineMath",
    "value", "",
    "data", JS.object(
      "hName", "code",
      "hProperties", JS.object("className", classNames("language-math", "math-inline")),
      "hChildren", JS.array()
    )
  );
  JS.invoke(self, "enter", node, token);
  JS.invoke(self, "buffer");
  return undef();
});

JsValue exitMathText = JS.method1((JsValue self, JsValue token) => {
  string data = JS.assume(JS.invoke(self, "resume"));
  JsValue[] stack = JS.assume(self["stack"]);
  JsValue node = stack[stack.length - 1];
  JS.invoke(self, "exit", token);
  node["value"] = data;
  JS.invoke((node["data"])["hChildren"], "push", textNode(data));
  return undef();
});

JsValue exitMathData = JS.method1((JsValue self, JsValue token) => {
  JsValue enterData = ((self["config"])["enter"])["data"];
  JsValue exitData = ((self["config"])["exit"])["data"];
  JS.call(enterData, self, token);
  JS.call(exitData, self, token);
  return undef();
});

  return JS.object(
    "enter", JS.object(
      "mathFlow", enterMathFlow,
      "mathFlowFenceMeta", enterMathFlowMeta,
      "mathText", enterMathText
    ),
    "exit", JS.object(
      "mathFlow", exitMathFlow,
      "mathFlowFence", exitMathFlowFence,
      "mathFlowFenceMeta", exitMathFlowMeta,
      "mathFlowValue", exitMathData,
      "mathText", exitMathText,
      "mathTextData", exitMathData
    )
  );
}
