import { DataBag, ParseSettings } from "./types.lil";
import { walkMath } from "./math.lil";

JsValue emptySettings() {
  return JS.object();
}

JsValue ensureBag(JsValue processor) {
  JsValue existing = processor["data"];
  string kind = JS.typeOf(existing);
  if (kind == "function") {
    JsValue bag = JS.invoke(processor, "data");
    if (JS.isUndefined(bag) || JS.isNullish(bag)) {
      return emptySettings();
    }
    return bag;
  }
  if (kind == "object" && !JS.isNullish(existing)) {
    return existing;
  }
  JsValue store = JS.object();
  processor["data"] = JS.method0((JsValue _self) => {
    return store;
  });
  return store;
}

JsValue ensureSettings(JsValue processor) {
  if (JS.isUndefined(processor) || JS.isNullish(processor)) {
    return emptySettings();
  }
  DataBag bag = JS.assume(ensureBag(processor));
  JsValue settings = bag.settings;
  if (JS.isUndefined(settings) || JS.isNullish(settings)) {
    settings = emptySettings();
    bag.settings = settings;
  }
  return settings;
}

JsValue transformTree(JsValue tree, JsValue file) {
  walkMath(tree);
  return tree;
}

JsValue remarkMathCall(JsValue self, JsValue options) {
  ParseSettings settings = JS.assume(ensureSettings(self));
  settings.math = true;
  return transformTree;
}

export JsValue remarkMath = JS.method1(remarkMathCall);

export JsValue default = remarkMath;
