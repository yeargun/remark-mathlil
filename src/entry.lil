import { ensureList, push, undef } from "./host.lil";
import { math } from "./syntax.lil";
import { mathFromMarkdown } from "./from-markdown.lil";
import { mathToMarkdown } from "./to-markdown.lil";

JsValue emptyOptions = JS.object();

JsValue remarkMathCall(JsValue self, JsValue options) {
  JsValue settings = emptyOptions;
  if (options.truthy()) {
    settings = options;
  }
  JsValue data = JS.invoke(self, "data");
  JS.invoke(ensureList(data, "micromarkExtensions"), "push", math(settings));
  JS.invoke(ensureList(data, "fromMarkdownExtensions"), "push", mathFromMarkdown());
  JS.invoke(ensureList(data, "toMarkdownExtensions"), "push", mathToMarkdown(settings));
  return undef();
}

JsValue remarkMath = JS.method1(remarkMathCall);
export JsValue default = remarkMath;
