import { ensureList, optionOrEmpty, push, undef } from "./host.lil";
import { math } from "./syntax.lil";
import { mathFromMarkdown } from "./from-markdown.lil";
import { mathToMarkdown } from "./to-markdown.lil";

JsValue remarkMathCall(JsValue self, JsValue options) {
  JsValue settings = optionOrEmpty(options);
  JsValue data = JS.invoke(self, "data");
  push(ensureList(data, "micromarkExtensions"), math(settings));
  push(ensureList(data, "fromMarkdownExtensions"), mathFromMarkdown());
  push(ensureList(data, "toMarkdownExtensions"), mathToMarkdown(settings));
  return undef();
}

export JsValue remarkMath = JS.method1(remarkMathCall);
export JsValue default = remarkMath;
