import { arrLen, call1, isEof, isUndef, jsInt, objGet, singleDollarEnabled, undef } from "./host.lil";
import { markdownLineEnding } from "./util-character.lil";
import { cDollarSign, cSpace, codeEq } from "./symbol/codes.lil";
import { tCharacterEscape, tLineEnding, tMathText, tMathTextData, tMathTextPadding, tMathTextSequence, tSpace } from "./symbol/types.lil";

JsValue resolveMathText = JS.method2((JsValue _self, JsValue events, JsValue _context) => {
  int tailExitIndex = arrLen(events) - 4;
  int headEnterIndex = 3;
  int index = 0;
  JsValue enter = undef();
  if ((objGet(events[headEnterIndex][1], "type") == tLineEnding || objGet(events[headEnterIndex][1], "type") == tSpace) && (objGet(events[tailExitIndex][1], "type") == tLineEnding || objGet(events[tailExitIndex][1], "type") == tSpace)) {
    index = headEnterIndex;
    while (true) {
      index = index + 1;
      if (index >= tailExitIndex) {
        break;
      }
      if (objGet(events[index][1], "type") == tMathTextData) {
        JS.set(events[tailExitIndex][1], "type", tMathTextPadding);
        JS.set(events[headEnterIndex][1], "type", tMathTextPadding);
        headEnterIndex = headEnterIndex + 2;
        tailExitIndex = tailExitIndex - 2;
        break;
      }
    }
  }
  index = headEnterIndex - 1;
  tailExitIndex = tailExitIndex + 1;
  while (true) {
    index = index + 1;
    if (index > tailExitIndex) {
      break;
    }
    if (isUndef(enter)) {
      if (index != tailExitIndex && objGet(events[index][1], "type") != tLineEnding) {
        enter = index;
      }
    } else if (index == tailExitIndex || objGet(events[index][1], "type") == tLineEnding) {
      int enterI = jsInt(enter);
      JS.set(events[enterI][1], "type", tMathTextData);
      if (index != enterI + 2) {
        JS.set(events[enterI][1], "end", objGet(events[index - 1][1], "end"));
        JS.call(JS.get(events, "splice"), events, enterI + 2, index - enterI - 2);
        tailExitIndex = tailExitIndex - (index - enterI - 2);
        index = enterI + 2;
      }
      enter = undef();
    }
  }
  return events;
});

JsValue previousMathText = JS.method1((JsValue self, JsValue code) => {
  if (!codeEq(code, cDollarSign)) {
    return true;
  }
  JsValue events = objGet(self, "events");
  return objGet(events[arrLen(events) - 1][1], "type") == tCharacterEscape;
});

export JsValue mathText(JsValue options) {
  bool single = singleDollarEnabled(options);

  JsValue tokenizeMathText = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
    JsValue st = JS.object();
    JS.set(st, "sizeOpen", 0);
    JS.set(st, "size", 0);
    JS.set(st, "token", undef());

    JsValue data = JS.method1((JsValue _s, JsValue code) => {
      if (isEof(code) || codeEq(code, cSpace) || codeEq(code, cDollarSign) || markdownLineEnding(code)) {
        call1(objGet(effects, "exit"), effects, tMathTextData);
        return call1(objGet(st, "between"), undef(), code);
      }
      call1(objGet(effects, "consume"), effects, code);
      return data;
    });

    JsValue sequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (codeEq(code, cDollarSign)) {
        call1(objGet(effects, "consume"), effects, code);
        JS.set(st, "size", JS.number(objGet(st, "size")) + 1.0);
        return sequenceClose;
      }
      if (JS.number(objGet(st, "size")) == JS.number(objGet(st, "sizeOpen"))) {
        call1(objGet(effects, "exit"), effects, tMathTextSequence);
        call1(objGet(effects, "exit"), effects, tMathText);
        return call1(ok, undef(), code);
      }
      JS.set(objGet(st, "token"), "type", tMathTextData);
      return call1(data, undef(), code);
    });

    JsValue between = JS.method1((JsValue _s, JsValue code) => {
      if (isEof(code)) {
        return call1(nok, undef(), code);
      }
      if (codeEq(code, cDollarSign)) {
        JS.set(st, "token", call1(objGet(effects, "enter"), effects, tMathTextSequence));
        JS.set(st, "size", 0);
        return call1(sequenceClose, undef(), code);
      }
      if (codeEq(code, cSpace)) {
        call1(objGet(effects, "enter"), effects, tSpace);
        call1(objGet(effects, "consume"), effects, code);
        call1(objGet(effects, "exit"), effects, tSpace);
        return between;
      }
      if (markdownLineEnding(code)) {
        call1(objGet(effects, "enter"), effects, tLineEnding);
        call1(objGet(effects, "consume"), effects, code);
        call1(objGet(effects, "exit"), effects, tLineEnding);
        return between;
      }
      call1(objGet(effects, "enter"), effects, tMathTextData);
      return call1(data, undef(), code);
    });

    JsValue sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
      if (codeEq(code, cDollarSign)) {
        call1(objGet(effects, "consume"), effects, code);
        JS.set(st, "sizeOpen", JS.number(objGet(st, "sizeOpen")) + 1.0);
        return sequenceOpen;
      }
      if (JS.number(objGet(st, "sizeOpen")) < 2.0 && !single) {
        return call1(nok, undef(), code);
      }
      call1(objGet(effects, "exit"), effects, tMathTextSequence);
      return call1(between, undef(), code);
    });

    JsValue start = JS.method1((JsValue _s, JsValue code) => {
      call1(objGet(effects, "enter"), effects, tMathText);
      call1(objGet(effects, "enter"), effects, tMathTextSequence);
      return call1(sequenceOpen, undef(), code);
    });

    JS.set(st, "between", between);
    return start;
  });

  JsValue construct = JS.object();
  JS.set(construct, "tokenize", tokenizeMathText);
  JS.set(construct, "resolve", resolveMathText);
  JS.set(construct, "previous", previousMathText);
  JS.set(construct, "name", "mathText");
  return construct;
}
