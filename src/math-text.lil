import { call1, objGet, singleDollarEnabled, undef } from "./host.lil";
import { markdownLineEnding } from "./util-character.lil";
import { cDollarSign, cSpace } from "./symbol/codes.lil";
import { tCharacterEscape, tLineEnding, tMathText, tMathTextData, tMathTextPadding, tMathTextSequence, tSpace } from "./symbol/types.lil";

JsValue resolveMathText = JS.method1((JsValue _self, JsValue events) => {
  JsValue[] eventList = JS.assume(events);
  int tailExitIndex = eventList.length - 4;
  int headEnterIndex = 3;
  int index = 0;
  int enter = -1;
  if ((events[headEnterIndex][1]["type"] == tLineEnding || events[headEnterIndex][1]["type"] == tSpace) && (events[tailExitIndex][1]["type"] == tLineEnding || events[tailExitIndex][1]["type"] == tSpace)) {
    index = headEnterIndex;
    while (index < tailExitIndex - 1) {
      index = index + 1;
      if (events[index][1]["type"] == tMathTextData) {
        events[tailExitIndex][1]["type"] = tMathTextPadding;
        events[headEnterIndex][1]["type"] = tMathTextPadding;
        headEnterIndex = headEnterIndex + 2;
        tailExitIndex = tailExitIndex - 2;
        break;
      }
    }
  }
  index = headEnterIndex - 1;
  tailExitIndex = tailExitIndex + 1;
  while (index < tailExitIndex) {
    index = index + 1;
    if (enter < 0) {
      if (index != tailExitIndex && events[index][1]["type"] != tLineEnding) {
        enter = index;
      }
    } else if (index == tailExitIndex || events[index][1]["type"] == tLineEnding) {
      int enterI = enter;
      events[enterI][1]["type"] = tMathTextData;
      if (index != enterI + 2) {
        events[enterI][1]["end"] = events[index - 1][1]["end"];
        JS.invoke(events, "splice", enterI + 2, index - enterI - 2);
        tailExitIndex = tailExitIndex - (index - enterI - 2);
        index = enterI + 2;
      }
      enter = -1;
    }
  }
  return events;
});

JsValue previousMathText = JS.method1((JsValue self, JsValue code) => {
  if (!JS.strictEqual(code, cDollarSign)) {
    return true;
  }
  JsValue events = self["events"];
  JsValue[] eventList = JS.assume(events);
  return eventList[eventList.length - 1][1]["type"] == tCharacterEscape;
});

export JsValue mathText(JsValue options) {
  bool single = singleDollarEnabled(options);

  JsValue tokenizeMathText = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
    float sizeOpen = 0.0;
    float size = 0.0;
    JsValue token = undef();
    JsValue between = undef();

    JsValue data = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, null) || JS.strictEqual(code, cSpace) ||
          JS.strictEqual(code, cDollarSign) || markdownLineEnding(code)) {
        JS.invoke(effects, "exit", tMathTextData);
        return JS.call(between, undef(), code);
      }
      JS.invoke(effects, "consume", code);
      return data;
    });

    JsValue sequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, cDollarSign)) {
        JS.invoke(effects, "consume", code);
        size = size + 1;
        return sequenceClose;
      }
      if (size == sizeOpen) {
        JS.invoke(effects, "exit", tMathTextSequence);
        JS.invoke(effects, "exit", tMathText);
        return JS.call(ok, undef(), code);
      }
      token["type"] = tMathTextData;
      return JS.call(data, undef(), code);
    });

    between = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, null)) {
        return JS.call(nok, undef(), code);
      }
      if (JS.strictEqual(code, cDollarSign)) {
        token = JS.invoke(effects, "enter", tMathTextSequence);
        size = 0;
        return JS.call(sequenceClose, undef(), code);
      }
      if (JS.strictEqual(code, cSpace)) {
        JS.invoke(effects, "enter", tSpace);
        JS.invoke(effects, "consume", code);
        JS.invoke(effects, "exit", tSpace);
        return between;
      }
      if (markdownLineEnding(code)) {
        JS.invoke(effects, "enter", tLineEnding);
        JS.invoke(effects, "consume", code);
        JS.invoke(effects, "exit", tLineEnding);
        return between;
      }
      JS.invoke(effects, "enter", tMathTextData);
      return JS.call(data, undef(), code);
    });

    JsValue sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, cDollarSign)) {
        JS.invoke(effects, "consume", code);
        sizeOpen = sizeOpen + 1;
        return sequenceOpen;
      }
      if (sizeOpen < 2 && !single) {
        return JS.call(nok, undef(), code);
      }
      JS.invoke(effects, "exit", tMathTextSequence);
      return JS.call(between, undef(), code);
    });

    JsValue start = JS.method1((JsValue _s, JsValue code) => {
      JS.invoke(effects, "enter", tMathText);
      JS.invoke(effects, "enter", tMathTextSequence);
      return JS.call(sequenceOpen, undef(), code);
    });

    return start;
  });

  JsValue construct = JS.object("tokenize", tokenizeMathText, "resolve", resolveMathText, "previous", previousMathText, "name", "mathText");
  return construct;
}
