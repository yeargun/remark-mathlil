import { call0, call1, call2, isNullish, objGet, objectAssign, pin, push, singleDollarEnabled, undef } from "./host.lil";

int longestStreak(string source, string substring) {
  int index = source.indexOf(substring);
  int expected = index;
  int count = 0;
  int max = 0;
  int step = substring.length;
  while (index != -1) {
    if (index == expected) {
      count = count + 1;
      if (count > max) {
        max = count;
      }
    } else {
      count = 1;
    }
    expected = index + step;
    index = source.indexOf(substring, expected);
  }
  return max;
}

string nodeText(JsValue node) {
  JsValue value = objGet(node, "value");
  if (value.truthy()) {
    return JS.assume(value);
  }
  return "";
}

JsValue inlineMathPeek = JS.method0((JsValue _self) => {
  return "$";
});

export JsValue mathToMarkdown(JsValue options) {
  bool single = singleDollarEnabled(options);

  JsValue handleMath = JS.methodRest((JsValue _self, JsValue args) => {
    JsValue node = args[0];
    JsValue state = args[2];
    JsValue info = args[3];
    string raw = nodeText(node);
    JsValue tracker = call1(objGet(state, "createTracker"), state, info);
    int size = longestStreak(raw, "$") + 1;
    if (size < 2) {
      size = 2;
    }
    string sequence = "$".repeat(size);
    JsValue exit = call1(objGet(state, "enter"), state, "mathFlow");
    string value = JS.assume(call1(objGet(tracker, "move"), tracker, sequence));
    JsValue meta = objGet(node, "meta");
    if (meta.truthy()) {
      JsValue subexit = call1(objGet(state, "enter"), state, "mathFlowMeta");
      JsValue safeOpts = JS.object("after", "\n", "before", value, "encode", JS.array("$"));
      objectAssign(safeOpts, call0(objGet(tracker, "current"), tracker));
      string safe = JS.assume(call2(objGet(state, "safe"), state, meta, safeOpts));
      string movedSafe = JS.assume(call1(objGet(tracker, "move"), tracker, safe));
      value = value + movedSafe;
      call0(subexit, undef());
    }
    string movedLine = JS.assume(call1(objGet(tracker, "move"), tracker, "\n"));
    value = value + movedLine;
    if (raw.length > 0) {
      string movedRaw = JS.assume(call1(objGet(tracker, "move"), tracker, raw + "\n"));
      value = value + movedRaw;
    }
    string movedClose = JS.assume(call1(objGet(tracker, "move"), tracker, sequence));
    value = value + movedClose;
    call0(exit, undef());
    return value;
  });

  JsValue handleInline = JS.method3((JsValue _self, JsValue node, JsValue _parent, JsValue state) => {
    string value = nodeText(node);
    int size = 1;
    if (!single) {
      size = size + 1;
    }
    while (true) {
      string dollars = "\\$".repeat(size);
      Regex probe = new Regex("(^|[^$])" + dollars + "([^$]|$)", "");
      if (!probe.test(value)) {
        break;
      }
      size = size + 1;
    }
    string sequence = "$".repeat(size);
    Regex hasContent = new Regex("[^ \\r\\n]", "");
    Regex startsSpace = new Regex("^[ \\r\\n]", "");
    Regex endsSpace = new Regex("[ \\r\\n]$", "");
    Regex dollarEdge = new Regex("^\\$|\\$$", "");
    if (hasContent.test(value) && (startsSpace.test(value) && endsSpace.test(value) || dollarEdge.test(value))) {
      value = " " + value + " ";
    }
    JsValue unsafe = objGet(state, "unsafe");
    int index = -1;
    int n = unsafe.length.toInt();
    while (true) {
      index = index + 1;
      if (index >= n) {
        break;
      }
      JsValue pattern = unsafe[index];
      if (!objGet(pattern, "atBreak").truthy()) {
        continue;
      }
      JsValue expression = call1(objGet(state, "compilePattern"), state, pattern);
      while (true) {
        JsValue found = JS.call(JS.get(expression, "exec"), expression, value);
        if (isNullish(found)) {
          break;
        }
        int position = JS.number(objGet(found, "index")).toInt();
        int matchIndex = position;
        JsValue text = value;
        JsValue at = JS.call(JS.get(text, "codePointAt"), text, position);
        if (JS.strictEqual(at, 10) &&
            JS.strictEqual(JS.call(JS.get(text, "codePointAt"), text, position - 1), 13)) {
          position = position - 1;
        }
        value = value.slice(0, position) + " " + value.slice(matchIndex + 1, value.length);
      }
    }
    return sequence + value + sequence;
  });

  JS.set(handleInline, "peek", inlineMathPeek);

  JsValue unsafe = JS.array(
    JS.object("character", "\r", "inConstruct", "mathFlowMeta"),
    JS.object("character", "\n", "inConstruct", "mathFlowMeta")
  );
  JsValue dollarPhrase = JS.object();
  JS.set(dollarPhrase, "character", "$");
  if (single) {
    pin(dollarPhrase, "after", undef());
  } else {
    JS.set(dollarPhrase, "after", "\\$");
  }
  JS.set(dollarPhrase, "inConstruct", "phrasing");
  push(unsafe, dollarPhrase);
  push(unsafe, JS.object("character", "$", "inConstruct", "mathFlowMeta"));
  push(unsafe, JS.object("atBreak", true, "character", "$", "after", "\\$"));

  return JS.object(
    "unsafe", unsafe,
    "handlers", JS.object("math", handleMath, "inlineMath", handleInline)
  );
}
