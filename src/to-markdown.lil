extern JsValue Object;
import { call0, call1, call2, isNullish, objGet, objectAssign, pin, push, singleDollarEnabled, undef } from "./host.lil";

int longestStreak(string source, string substring) {
  int index = source.indexOf(substring);
  int expected = index;
  int count = 0;
  int max = 0;
  int step = substring.length;
  while (index != -1) {
    if (index == expected) {
      count = count + 1;
      if (count > max) {
        max = count;
      }
    } else {
      count = 1;
    }
    expected = index + step;
    index = source.indexOf(substring, expected);
  }
  return max;
}

string nodeText(JsValue node) {
  JsValue value = node["value"];
  if (value.truthy()) {
    return JS.assume(value);
  }
  return "";
}

JsValue inlineMathPeek = JS.method0((JsValue _self) => {
  return "$";
});

export JsValue mathToMarkdown(JsValue options) {
  bool single = singleDollarEnabled(options);

  JsValue handleMath = (JsValue node, JsValue _parent, JsValue state, JsValue info) => {
    string raw = nodeText(node);
    JsValue tracker = JS.invoke(state, "createTracker", info);
    int size = longestStreak(raw, "$") + 1;
    if (size < 2) {
      size = 2;
    }
    string sequence = "$".repeat(size);
    JsValue exit = JS.invoke(state, "enter", "mathFlow");
    string value = JS.assume(JS.invoke(tracker, "move", sequence));
    JsValue meta = node["meta"];
    if (meta.truthy()) {
      JsValue subexit = JS.invoke(state, "enter", "mathFlowMeta");
      JsValue safeOpts = JS.invoke(Object, "assign", JS.object("after", "\n", "before", value, "encode", JS.array("$")), JS.invoke(tracker, "current"));
      string safe = JS.assume(JS.invoke(state, "safe", meta, safeOpts));
      string movedSafe = JS.assume(JS.invoke(tracker, "move", safe));
      value = value + movedSafe;
      JS.call(subexit, undef());
    }
    string movedLine = JS.assume(JS.invoke(tracker, "move", "\n"));
    value = value + movedLine;
    if (raw.length > 0) {
      string movedRaw = JS.assume(JS.invoke(tracker, "move", raw + "\n"));
      value = value + movedRaw;
    }
    string movedClose = JS.assume(JS.invoke(tracker, "move", sequence));
    value = value + movedClose;
    JS.call(exit, undef());
    return value;
  };

  JsValue handleInline = JS.method3((JsValue _self, JsValue node, JsValue _parent, JsValue state) => {
    string value = nodeText(node);
    int size = 1;
    if (!single) {
      size = size + 1;
    }
    while (true) {
      string dollars = "\\$".repeat(size);
      Regex probe = new Regex("(^|[^$])" + dollars + "([^$]|$)", "");
      if (!probe.test(value)) {
        break;
      }
      size = size + 1;
    }
    string sequence = "$".repeat(size);
    Regex hasContent = new Regex("[^ \\r\\n]", "");
    Regex startsSpace = new Regex("^[ \\r\\n]", "");
    Regex endsSpace = new Regex("[ \\r\\n]$", "");
    Regex dollarEdge = new Regex("^\\$|\\$$", "");
    if (hasContent.test(value) && (startsSpace.test(value) && endsSpace.test(value) || dollarEdge.test(value))) {
      value = " " + value + " ";
    }
    JsValue unsafe = state["unsafe"];
    for (int index = 0; index < unsafe.length.toInt(); index++) {
      JsValue pattern = unsafe[index];
      if (!pattern["atBreak"].truthy()) {
        continue;
      }
      JsValue expression = JS.invoke(state, "compilePattern", pattern);
      while (true) {
        JsValue found = JS.invoke(expression, "exec", value);
        if (isNullish(found)) {
          break;
        }
        int position = JS.number(found["index"]).toInt();
        int matchIndex = position;
        if (value.charCodeAt(position) == 10 && value.charCodeAt(position - 1) == 13) {
          position = position - 1;
        }
        value = value.slice(0, position) + " " + value.slice(matchIndex + 1, value.length);
      }
    }
    return sequence + value + sequence;
  });

  handleInline["peek"] = inlineMathPeek;

  JsValue unsafe = JS.array(
    JS.object("character", "\r", "inConstruct", "mathFlowMeta"),
    JS.object("character", "\n", "inConstruct", "mathFlowMeta"),
    JS.object("character", "$", "after", if (single) { JS.undefined() } else { "\\$" }, "inConstruct", "phrasing"),
    JS.object("character", "$", "inConstruct", "mathFlowMeta"),
    JS.object("atBreak", true, "character", "$", "after", "\\$")
  );

  return JS.object(
    "unsafe", unsafe,
    "handlers", JS.object("math", handleMath, "inlineMath", handleInline)
  );
}
