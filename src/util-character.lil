import { cHorizontalTab, cSpace, cVirtualSpace } from "./symbol/codes.lil";

export bool markdownLineEnding(JsValue code) {
  return !JS.strictEqual(code, null) && JS.number(code) < cHorizontalTab;
}

export bool markdownSpace(JsValue code) {
  return JS.strictEqual(code, cHorizontalTab) || JS.strictEqual(code, cVirtualSpace) ||
    JS.strictEqual(code, cSpace);
}
