int childCount(JsValue children) {
  return JS.number(children["length"]).toInt();
}

void replaceChild(JsValue children, int index, JsValue parts) {
  JS.invoke(children, "splice", index, 1);
  int j = 0;
  int n = childCount(parts);
  while (j < n) {
    JS.invoke(children, "splice", index + j, 0, parts[j]);
    j = j + 1;
  }
}

int findDelim(string value, int start, string delim) {
  int i = start;
  int n = value.length;
  int dlen = delim.length;
  while (i < n) {
    if (value.charAt(i) == "\\" && i + 1 < n && value.charAt(i + 1) == "$") {
      i = i + 2;
      continue;
    }
    if (i + dlen <= n && value.slice(i, i + dlen) == delim) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

void flushText(JsValue parts, string buf) {
  if (buf.length > 0) {
    JS.push(parts, JS.object("type", "text", "value", buf));
  }
}

JsValue splitMath(string value) {
  JsValue parts = JS.array();
  string buf = "";
  int i = 0;
  int n = value.length;
  while (i < n) {
    if (value.charAt(i) == "\\" && i + 1 < n && value.charAt(i + 1) == "$") {
      buf = buf + "\\$";
      i = i + 2;
      continue;
    }
    if (i + 1 < n && value.slice(i, i + 2) == "$$") {
      int close = findDelim(value, i + 2, "$$");
      if (close >= 0) {
        flushText(parts, buf);
        buf = "";
        JS.push(parts, JS.object("type", "math", "value", value.slice(i + 2, close)));
        i = close + 2;
        continue;
      }
    }
    if (value.charAt(i) == "$") {
      int close = findDelim(value, i + 1, "$");
      if (close >= 0) {
        flushText(parts, buf);
        buf = "";
        JS.push(parts, JS.object("type", "inlineMath", "value", value.slice(i + 1, close)));
        i = close + 1;
        continue;
      }
    }
    buf = buf + value.charAt(i);
    i = i + 1;
  }
  flushText(parts, buf);
  return parts;
}

bool partsHaveMath(JsValue parts) {
  int i = 0;
  int n = childCount(parts);
  while (i < n) {
    string ty = JS.string(parts[i]["type"]);
    if (ty == "math" || ty == "inlineMath") {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export void walkMath(JsValue node) {
  if (JS.isUndefined(node) || JS.isNullish(node)) {
    return;
  }
  string ty = JS.string(node["type"]);
  if (ty == "code" || ty == "inlineCode") {
    return;
  }
  JsValue children = node["children"];
  if (!JS.isArray(children)) {
    return;
  }
  int i = 0;
  int n = childCount(children);
  while (i < n) {
    JsValue child = children[i];
    string cty = JS.string(child["type"]);
    if (cty == "text") {
      JsValue raw = child["value"];
      if (raw is string) {
        if (raw.indexOf("$") >= 0) {
          JsValue parts = splitMath(raw);
          if (partsHaveMath(parts)) {
            replaceChild(children, i, parts);
            int added = childCount(parts);
            n = n + added - 1;
            i = i + added;
            continue;
          }
        }
      }
    } else {
      walkMath(child);
    }
    i = i + 1;
  }
}
