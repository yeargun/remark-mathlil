import { call0, call1, call2, call3, objGet, undef } from "./host.lil";
import { factorySpace } from "./factory-space.lil";
import { markdownLineEnding } from "./util-character.lil";
import { cDollarSign } from "./symbol/codes.lil";
import { kContentTypeString, kTabSize } from "./symbol/constants.lil";
import { tChunkString, tLineEnding, tLinePrefix, tMathFlow, tMathFlowFence, tMathFlowFenceMeta, tMathFlowFenceSequence, tMathFlowValue, tWhitespace } from "./symbol/types.lil";

JsValue tokenizeNonLazyContinuation = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue lineStart = JS.method1((JsValue _s, JsValue code) => {
    if ((self["parser"])["lazy"][(JS.invoke(self, "now"))["line"]].truthy()) {
      return JS.call(nok, undef(), code);
    }
    return JS.call(ok, undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(ok, undef(), code);
    }
    JS.invoke(effects, "enter", tLineEnding);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLineEnding);
    return lineStart;
  });

  return start;
});

JsValue nonLazyContinuation = JS.object("tokenize", tokenizeNonLazyContinuation, "partial", true);

JsValue tokenizeMathFenced = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue[] events = JS.assume(self["events"]);
  float initialSize = 0.0;
  if (events.length > 0) {
    JsValue tail = events[events.length - 1];
    if (tail.truthy() && tail[1]["type"] == tLinePrefix) {
      string serialized = JS.assume(JS.invoke(tail[2], "sliceSerialize", tail[1], true));
      initialSize = serialized.length;
    }
  }
  float sizeOpen = 0.0;
  JsValue beforeContentChunk = undef();
  JsValue beforeNonLazyContinuation = undef();
  JsValue metaAfter = undef();

  JsValue tokenizeClosingFence = JS.method3((JsValue _ctx, JsValue closeEffects, JsValue closeOk, JsValue closeNok) => {
    float size = 0.0;

    JsValue afterSequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
        JS.invoke(closeEffects, "exit", tMathFlowFence);
        return JS.call(closeOk, undef(), code);
      }
      return JS.call(closeNok, undef(), code);
    });

    JsValue sequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, cDollarSign)) {
        size = size + 1;
        JS.invoke(closeEffects, "consume", code);
        return sequenceClose;
      }
      if (size < sizeOpen) {
        return JS.call(closeNok, undef(), code);
      }
      JS.invoke(closeEffects, "exit", tMathFlowFenceSequence);
      return JS.call(factorySpace(closeEffects, afterSequenceClose, tWhitespace, undef()), undef(), code);
    });

    JsValue beforeSequenceClose = JS.method1((JsValue _s, JsValue code) => {
      JS.invoke(closeEffects, "enter", tMathFlowFence);
      JS.invoke(closeEffects, "enter", tMathFlowFenceSequence);
      return JS.call(sequenceClose, undef(), code);
    });

    JsValue max = kTabSize;
    JsValue disabled = ((self["parser"])["constructs"])["disable"]["null"];
    if (JS.invoke(disabled, "includes", "codeIndented").truthy()) {
      max = undef();
    }
    return factorySpace(closeEffects, beforeSequenceClose, tLinePrefix, max);
  });

  JsValue closeConstruct = JS.object("tokenize", tokenizeClosingFence, "partial", true);

  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tMathFlow);
    return JS.call(ok, undef(), code);
  });

  JsValue contentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tMathFlowValue);
      return JS.call(beforeContentChunk, undef(), code);
    }
    JS.invoke(effects, "consume", code);
    return contentChunk;
  });

  beforeContentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(after, undef(), code);
    }
    if (markdownLineEnding(code)) {
      return JS.call(JS.invoke(effects, "attempt", nonLazyContinuation, beforeNonLazyContinuation, after), undef(), code);
    }
    JS.invoke(effects, "enter", tMathFlowValue);
    return JS.call(contentChunk, undef(), code);
  });

  JsValue contentStart = JS.method1((JsValue _s, JsValue code) => {
    if (initialSize > 0) {
      return JS.call(factorySpace(effects, beforeContentChunk, tLinePrefix, initialSize + 1), undef(), code);
    }
    return JS.call(beforeContentChunk, undef(), code);
  });

  beforeNonLazyContinuation = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(JS.invoke(effects, "attempt", closeConstruct, after, contentStart), undef(), code);
  });

  JsValue meta = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", tMathFlowFenceMeta);
      return JS.call(metaAfter, undef(), code);
    }
    if (JS.strictEqual(code, cDollarSign)) {
      return JS.call(nok, undef(), code);
    }
    JS.invoke(effects, "consume", code);
    return meta;
  });

  metaAfter = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tMathFlowFence);
    if (self["interrupt"].truthy()) {
      return JS.call(ok, undef(), code);
    }
    return JS.call(JS.invoke(effects, "attempt", nonLazyContinuation, beforeNonLazyContinuation, after), undef(), code);
  });

  JsValue metaBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(metaAfter, undef(), code);
    }
    JS.invoke(effects, "enter", tMathFlowFenceMeta);
    JsValue fields = JS.object("contentType", kContentTypeString);
    JS.invoke(effects, "enter", tChunkString, fields);
    return JS.call(meta, undef(), code);
  });

  JsValue sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, cDollarSign)) {
      JS.invoke(effects, "consume", code);
      sizeOpen = sizeOpen + 1;
      return sequenceOpen;
    }
    if (sizeOpen < 2) {
      return JS.call(nok, undef(), code);
    }
    JS.invoke(effects, "exit", tMathFlowFenceSequence);
    return JS.call(factorySpace(effects, metaBefore, tWhitespace, undef()), undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tMathFlow);
    JS.invoke(effects, "enter", tMathFlowFence);
    JS.invoke(effects, "enter", tMathFlowFenceSequence);
    return JS.call(sequenceOpen, undef(), code);
  });

  return start;
});

export JsValue mathFlow = JS.object("tokenize", tokenizeMathFenced, "concrete", true, "name", "mathFlow");
